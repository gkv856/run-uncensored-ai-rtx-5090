# Fallback: gated checkpoint with stronger published quantisation checks.
PROFILE_NAME=tomsarihan-vllm-32k
PROFILE_ROLE=fidelity-fallback
ENGINE=vllm
ENGINE_VERSION=0.27.1

MODEL_ID=tomsarihan/Qwen3.8-27B-Uncensored-NVFP4
MODEL_REVISION=REPLACE_WITH_FULL_COMMIT_SHA
SERVED_MODEL_NAME=local-model
GATED_REPOSITORY=1
PUBLISHED_MODEL_GIB=23.42

BIND_HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=32768
TRUST_REMOTE_CODE=0
SPECULATIVE_DECODING=0

EXPECTED_GPU_NAME_REGEX=RTX.5090
MIN_GPU_MEMORY_MIB=30000
MIN_CUDA_COMPUTE_MAJOR=12
MIN_DOWNLOAD_FREE_GIB=33
MIN_RUNTIME_FREE_GIB=5

# The checkpoint declares mixed precision and calibrated FP8 KV itself.
# Passing either override would defeat the published configuration.
QUANTIZATION=
DTYPE=auto
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
ENABLE_CHUNKED_PREFILL=1
ENABLE_PREFIX_CACHING=1
ENABLE_AUTO_TOOL_CHOICE=1
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
LIMIT_MM_PER_PROMPT=
MM_PROCESSOR_KWARGS=
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

