# Primary: conservative single-user RTX 5090 profile.
PROFILE_NAME=fleetml-sglang-32k
PROFILE_ROLE=primary
ENGINE=sglang
ENGINE_VERSION=0.5.19
CUDA_RUNTIME_PACKAGE_VERSION=13.4.92
CUDA_COMPILER_PACKAGE_VERSION=13.4.92

MODEL_ID=fleetml/Qwen3.8-27B-Uncensored-NVFP4-RTX5090
MODEL_REVISION=REPLACE_WITH_FULL_COMMIT_SHA
# This is the friendly alias exposed in Open WebUI and the private API model list.
SERVED_MODEL_NAME='Qwen UnCensored'
GATED_REPOSITORY=0
PUBLISHED_MODEL_GIB=20.59

BIND_HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=32768
TRUST_REMOTE_CODE=0
SPECULATIVE_DECODING=0

EXPECTED_GPU_NAME_REGEX=RTX.5090
MIN_GPU_MEMORY_MIB=30000
MIN_CUDA_COMPUTE_MAJOR=12
MIN_DOWNLOAD_FREE_GIB=40
MIN_RUNTIME_FREE_GIB=10

QUANTIZATION=modelopt_fp4
DTYPE=auto
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
ATTENTION_BACKEND=flashinfer
CHUNKED_PREFILL_SIZE=2048
MAX_RUNNING_REQUESTS=1
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer_lazy
MAMBA_SSM_DTYPE=bfloat16
MAX_MAMBA_CACHE_SIZE=4
CUDA_GRAPH_MAX_BS_DECODE=1
MM_FEATURE_TRANSPORT=cpu
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
ENABLE_METRICS=1
