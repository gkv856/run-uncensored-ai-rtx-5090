# Copy to ~/.config/uncensored-ai/runtime.env and chmod 600.
# Never put the populated copy in this repository.

API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Needed only for gated/private Hugging Face repositories. Use a read-only token.
HF_TOKEN=

# Provider-neutral defaults. Change DATA_ROOT only when the provider documents a
# separate persistent disk path; do not infer persistence from a directory name.
DATA_ROOT=$HOME/.local/share/uncensored-ai
MODEL_STORE=$DATA_ROOT/models
ENGINE_VENV_ROOT=$DATA_ROOT/venvs
LOG_ROOT=$DATA_ROOT/logs
RUN_ROOT=$DATA_ROOT/run
PROFILE_OVERRIDE_DIR=$HOME/.config/uncensored-ai/profiles

START_POWER_LOG=1
STARTUP_TIMEOUT_SECONDS=900
SUPERVISOR_MAX_RESTARTS=2
SUPERVISOR_RESTART_DELAY_SECONDS=5

# A tracked profile must also request remote code. Keep this at zero normally.
ALLOW_REMOTE_CODE=0
